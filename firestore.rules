rules_version = '2';

// Правила базы бортжурнала. Вставляются в консоли Firebase: Firestore → Правила.
service cloud.firestore {
  match /databases/{database}/documents {

    // Пускаем только двух пилотов эскадрильи (адреса — как в PILOTS в app.js)
    function isPilot() {
      return request.auth != null
        && request.auth.token.email in ['pilot1@bortzhurnal.example', 'pilot2@bortzhurnal.example'];
    }

    function validSortie() {
      let d = request.resource.data;
      return d.uid == request.auth.uid
        && d.target is string && d.target.size() > 0 && d.target.size() <= 24
        && d.note is string && d.note.size() <= 1000
        && d.result in ['refused', 'recon', 'refuel', 'lowfly', 'hit'];
    }

    // Личный бортжурнал: позывные целей и заметки видит только автор
    match /sorties/{id} {
      allow read, delete: if isPilot() && resource.data.uid == request.auth.uid;
      allow create: if isPilot() && validSortie();
      allow update: if isPilot() && resource.data.uid == request.auth.uid && validSortie();
    }

    // Общее табло: даты, результаты и номера целей без позывных — видят оба пилота
    match /boards/{uid} {
      allow read: if isPilot();
      allow write: if isPilot() && request.auth.uid == uid;
    }

    // Отметка о том, что одноразовый ключ заменён паролем
    match /pilots/{uid} {
      allow read, write: if isPilot() && request.auth.uid == uid;
    }
  }
}
